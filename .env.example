# Flutter compile-time configuration. These values may be in the client only
# because Supabase RLS protects the data.
ITER_BACKEND=mock
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Do not pass the following values to Flutter, do not put them in dart-defines,
# and do not commit them. Configure them as Supabase Edge Function secrets
# instead (for example: `supabase secrets set GEMINI_API_KEY=...`).
#
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ORS_API_KEY=
# ITER_DAILY_GENERATION_LIMIT=2
# ITER_GLOBAL_DAILY_GENERATION_LIMIT=<roughly 70 percent of the current Gemini quota>
