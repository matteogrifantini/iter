# Backend mode: 'mock' (default, deterministic fixtures) or 'supabase'
ITER_BACKEND=mock

# Supabase Configuration (Required only when ITER_BACKEND=supabase)
# Never commit real URLs or anon keys to this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google AI Studio / Gemini Configuration
# NOTE: In production/supabase mode, Gemini API keys belong exclusively
# in backend secrets (Supabase Edge Function secrets), NEVER in Flutter client code.
GEMINI_MODEL=gemini-2.5-flash
